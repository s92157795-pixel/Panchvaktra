{
  "version": 2,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/(ngo_watermark.png|logo.png|logo_emblem.png|logo_full.png|logo_icon.png|logo_original.jpg)",
      "destination": "/logos/$1"
    },
    {
      "source": "/(team_member_.*\\.jpg)",
      "destination": "/team/$1"
    },
    {
      "source": "/(PV.*\\.jpeg)",
      "destination": "/gallery/$1"
    },
    {
      "source": "/glimpses-bg.jpg",
      "destination": "/backgrounds/glimpses-bg.jpg"
    },
    {
      "source": "/PanchvaktraVideo.mp4",
      "destination": "/videos/PanchvaktraVideo.mp4"
    }
  ]
}
